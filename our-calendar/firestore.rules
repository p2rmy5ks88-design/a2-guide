rules_version = '2';

// Only your two accounts can read or change anything.
// Replace the two addresses below with yours (lowercase), then paste this whole file into
// Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function isUs() {
      return request.auth != null
        && request.auth.token.email.lower() in ['you@example.com', 'wife@example.com'];
    }
    match /{document=**} {
      allow read, write: if isUs();
    }
  }
}
