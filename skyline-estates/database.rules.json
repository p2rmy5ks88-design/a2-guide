{
  "rules": {
    "games": {
      ".read": "auth != null",
      ".indexOn": ["status"],
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{5}$/)"
      }
    },
    "sub": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "locks": {
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "usr": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "lb": {
      "$season": {
        ".read": "auth != null",
        ".indexOn": ["t"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $season.matches(/^s[0-9]{1,4}$/)",
          ".validate": "newData.hasChildren(['n','t','at']) && newData.child('n').isString() && newData.child('n').val().length <= 12 && newData.child('t').isNumber() && newData.child('t').val() >= 0 && newData.child('t').val() <= 100000 && newData.child('at').isNumber()"
        }
      }
    },
    "reports": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid",
        ".validate": "newData.hasChildren(['by','who','why','at']) && newData.child('why').isString() && newData.child('why').val().length <= 20"
      }
    }
  }
}
