{
  "rules": {
    ".read": false,
    ".write": false,
    "skylineV2": {
      "rooms": {
        "$room": {
          "meta": {
            ".read": "auth != null && root.child('skylineV2').child('rooms').child($room).child('members').child(auth.uid).val() === true"
          },
          "members": {
            ".read": "auth != null && root.child('skylineV2').child('rooms').child($room).child('members').child(auth.uid).val() === true"
          },
          "state": {
            ".read": false
          },
          "presence": {
            "$uid": {
              ".read": "auth != null && root.child('skylineV2').child('rooms').child($room).child('members').child(auth.uid).val() === true",
              ".write": "auth != null && root.child('skylineV2').child('rooms').child($room).child('members').child(auth.uid).val() === true && auth.uid === $uid && root.child('skylineV2').child('rooms').child($room).child('meta').child('status').val() === 'playing' && newData.exists()",
              ".validate": "newData.hasChildren(['uid','at','left']) && newData.child('at').val() === now",
              "uid": {
                ".validate": "newData.isString() && newData.val() === auth.uid"
              },
              "at": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "left": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "requests": {
            "$uid": {
              "$request": {
                ".read": "auth != null && root.child('skylineV2').child('rooms').child($room).child('members').child(auth.uid).val() === true && auth.uid === $uid",
                ".write": "auth != null && root.child('skylineV2').child('rooms').child($room).child('members').child(auth.uid).val() === true && auth.uid === $uid && root.child('skylineV2').child('rooms').child($room).child('meta').child('status').val() === 'playing' && $request.matches(/^[A-Za-z0-9_-]{8,64}$/) && !data.exists() && newData.exists()",
                ".validate": "newData.hasChildren(['uid','kind','rev','at','payload'])",
                "uid": {
                  ".validate": "newData.isString() && newData.val() === auth.uid"
                },
                "kind": {
                  ".validate": "newData.isString() && newData.val().matches(/^(roll|buy|decline|bid|endTurn|build|sell|mortgage|redeem|trade|jail|answer|leave|reclaim)$/)"
                },
                "rev": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() === root.child('skylineV2').child('rooms').child($room).child('state').child('revision').val()"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "payload": {
                  ".validate": "newData.isString() && newData.val().length <= 4096"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        }
      }
    },
    "skylineWalletV1": {
      "$environment": {
        "outbox": {
          ".indexOn": [
            "nextAt"
          ]
        }
      }
    }
  }
}
